# HUX Store — environment template. Copy to .env (local) or set as Netlify env vars.

# --- PostgreSQL (Neon free tier: https://neon.tech) ---
# DATABASE_URL = POOLED connection (host contains "-pooler") — used by the app
# DIRECT_URL   = DIRECT connection (no "-pooler") — used by prisma db push/migrate
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/hux?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hux?sslmode=require"

# --- Auth (generate a strong secret: openssl rand -base64 32) ---
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_COOKIE_CUSTOMER="hux_customer_session"
AUTH_COOKIE_STAFF="hux_staff_session"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
NEXT_PUBLIC_SITE_NAME="HUX"

# --- Manual Pix ---
PIX_KEY="contato@hux.com.br"
PIX_MERCHANT_NAME="HUX RUN LTDA"
PIX_MERCHANT_CITY="SAO PAULO"

# --- Seed admin ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# --- Leitura de Nota Fiscal com IA (opcional) ---
# Pegue a chave em https://console.anthropic.com → Settings → API Keys → Create Key.
# Cole abaixo (local) e/ou nas variáveis de ambiente da Netlify, e faça um redeploy.
# ANTHROPIC_MODEL é opcional; padrão claude-sonnet-5. Para testar barato: claude-haiku-4-5-20251001.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- E-mail (avise-me quando voltar) — opcional, via Resend ---
# RESEND_API_KEY="re_..."
# RESEND_FROM="HUX <no-reply@seudominio.com>"
